[Unit]
Description=Financial Bots (Telegram + Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/financial-pbi
Environment=TZ=America/Sao_Paulo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/financial-pbi/venv/bin/python /opt/financial-pbi/run_bots.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target