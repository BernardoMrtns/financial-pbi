                "        {\"tipo\", \"Tipo\"}, {\"metodo\", \"Metodo\"}, {\"conta_cartao\", \"Conta_Cartao\"},",
                "        {\"categoria\", \"Categoria\"}, {\"descricao\", \"Descricao\"}, {\"valor\", \"Valor\"},",
                "        {\"status\", \"Status\"}, {\"valor_fluxo\", \"ValorFluxo\"}",
                "    }),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(Renamed,{{\"DataOriginal\", type datetime}, {\"DataCompetencia\", type datetime}, {\"Tipo\", type text}, {\"Metodo\", type text}, {\"Conta_Cartao\", type text}, {\"Categoria\", type text}, {\"Descricao\", type text}, {\"Valor\", Currency.Type}, {\"Status\", type text}, {\"ValorFluxo\", Currency.Type}})",
                "in",
                "    #\"Tipo Alterado\""
              ],
              "type": "m"
            }
          }
