        "partitions": [
          {
            "name": "dCalendario",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "ADDCOLUMNS (",
                "    CALENDARAUTO(),",
                "    \"DateTime\", [Date] + TIME(0,0,0),",
                "    \"Ano\", YEAR([Date]),",
                "    \"Mês\", FORMAT([Date], \"mmmm\"),",
                "    \"Mês Abrev\", FORMAT([Date], \"mmm\"),",
                "    \"Mês Num\", MONTH([Date]),",
                "    \"AnoMês\", FORMAT([Date], \"yyyy-MM\"),",
                "    \"Trimestre\", \"T\" & QUARTER([Date])",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          }
        ],
        "lineageTag": "72a6ae09-2f08-4e85-8d48-6f895404bb9a",
        "measures": [
          {
            "name": "SaldoCDI",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "VAR UltimaData =",
              "    MAX(InvestimentoCDI[DataHora])",
              "RETURN",
              "CALCULATE(",
              "    SUM(InvestimentoCDI[ValorCDI]),",
              "    InvestimentoCDI[DataHora] = UltimaData",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "eb23c053-d525-4714-b2f6-9bb652a074fa"
          },
          {
            "name": "DividaAtual",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(FluxoCaixaCompleto[Valor]),",
              "    FluxoCaixaCompleto[Status] = \"Pendente\"",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "30831ecf-fa25-46c7-b1b4-e22233638dc8"
          },
          {
            "name": "TotalParcelasMes",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(FluxoCaixaCompleto[Valor]),",
              "    FluxoCaixaCompleto[Tipo] = \"Saida\",",
              "    FluxoCaixaCompleto[Metodo] IN {",
              "        \"Cartao de Credito\",",
              "        \"Pix Parcelado\",",
              "        \"Assinatura Recorrente\"",
              "    }",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "9c03f31c-6e45-4a24-963a-842cbf94a13a"
          },
          {
            "name": "PatrimonioBTCAtual",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(InvestimentoBTC[ValorReais]),",
              "    InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "bd4ca602-57d4-43c3-9bac-f16aebf721fb"
          },
          {
            "name": "SaldoBTC (Qtd)",
            "expression": [
              "",
              "CALCULATE(",
              "    MAX(InvestimentoBTC[SaldoBTC]),",
              "    InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])",
              ")"
            ],
            "formatString": "0.00000000",
            "lineageTag": "fe6d4909-c90b-447e-9958-c6d83564e513"
          },
          {
            "name": "ValorCarteiraBTC",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(InvestimentoBTC[ValorReais]),",
              "    InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])",
              ")",
              ""
            ],
            "formatString": "\"R$\"\\ #,0.###############;-\"R$\"\\ #,0.###############;\"R$\"\\ #,0.###############",
            "lineageTag": "0becae7d-77be-4ac3-921c-7d455a4af914"
          },
          {
            "name": "CotaçãoBTC",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    MAX(InvestimentoBTC[PrecoBTC]),",
              "    FILTER(",
              "        ALL(InvestimentoBTC),",
              "        InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])",
              "    )",
              ")"
            ],
            "lineageTag": "8b545cc5-7f6b-48c9-9f8f-5e35710a0f08"
          },
          {
            "name": "Satoshis",
            "expression": "[SaldoBTC (Qtd)] * 100000000",
            "formatString": "0",
            "lineageTag": "6ca937fd-cae2-4a96-acc1-8b4e4d550738"
          },
          {
            "name": "TotalReceitas",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(FluxoCaixaCompleto[Valor]),",
              "    FILTER(",
              "        FluxoCaixaCompleto,",
              "        FluxoCaixaCompleto[Tipo] = \"Entrada\"",
              "            && FluxoCaixaCompleto[Metodo] <> \"Resgate Investimento\"",
              "    )",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "00449243-7e45-4381-9bb3-aa121aa25823"
          },
          {
            "name": "TotalDespesas",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(FluxoCaixaCompleto[Valor]),",
              "    FILTER(",
              "        FluxoCaixaCompleto,",
              "        FluxoCaixaCompleto[Tipo] = \"Saida\"",
              "            && FluxoCaixaCompleto[Categoria] <> \"Investimento\"",
              "    )",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "c58b48de-0a9a-46ac-827d-0d5325cb7a05"
          },
          {
            "name": "SaldoMes",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": "[TotalReceitas] - [TotalDespesas]",
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "4fe9f9f1-eb51-471d-86e2-26aef14db600"
          },
          {
            "name": "SaldoCDI(Histórico)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR DataAtual = MAX(dCalendario[Date])",
              "RETURN",
              "CALCULATE(",
              "    SUM(InvestimentoCDI[ValorCDI]),",
              "    FILTER(",
              "        ALL(dCalendario), -- Remove filtros de data (olha o calendário todo)",
              "        dCalendario[Date] <= DataAtual -- Pega tudo que aconteceu ANTES ou ATÉ hoje",
              "    )",
              ")"
            ],
            "lineageTag": "35d51c0a-a118-4baa-90fe-6929cb037ed3"
          },
          {
            "name": "CorPatrimonio",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    [PatrimonioReal] <= 4800, \"#C00000\",",
              "    [PatrimonioReal] <= 14444, \"#E6B300\",",
              "    [PatrimonioReal] < 28800, \"#808080\",",
              "    \"#4472C4\"",
              ")"
            ],
            "lineageTag": "fd5718f2-27ca-4952-bb1e-ffbc9d5dbd28"
          },
          {
            "name": "TotalAportado(Mês)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    [TotalDespesas],",
              "    FluxoCaixaCompleto[Categoria] = \"Investimento\"",
              ")"
            ],
            "lineageTag": "5d1eee72-ecf8-4330-af33-2dfa0bde6f72"
          },
          {
            "name": "LimiteTotal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": "SUM(Limites[LimiteTotal])",
            "formatString": "\"R$\"\\ #,0;-\"R$\"\\ #,0;\"R$\"\\ #,0",
            "lineageTag": "007cc70a-f66f-4030-8074-ba3c8ca0815b"
          },
          {
            "name": "LimiteUsado",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(FluxoCaixaCompleto[Valor]),",
              "    FluxoCaixaCompleto[Metodo] = \"Cartao de Credito\",",
              "    dCalendario[Date] >= TODAY() ",
              ")"
            ],
            "lineageTag": "27789dac-3d4c-4351-95d5-a37f4470d339"
          },
          {
            "name": "LimiteDisponível",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": "[LimiteTotal] - [LimiteUsado]",
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "edaea839-dff3-480b-aa4e-fb5d84747297"
          },
          {
            "name": "% Limite Tomado",
            "expression": "DIVIDE([LimiteUsado], [LimiteTotal], 0)",
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "8fd778a8-62c5-4863-ac20-617346ce37a7"
          },
          {
            "name": "% Limite Disponível",
            "expression": [
              "",
              "DIVIDE(",
              "    [LimiteDisponível], ",
              "    [LimiteTotal], ",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "21112d8b-0295-4321-a5ca-849beb92d7b0"
          },
          {
            "name": "Saldo CDI Acumulado",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(FluxoCaixaCompleto[Valor]), ",
              "    FILTER(",
              "        ALL(dCalendario),",
              "        dCalendario[Date] <= MAX(dCalendario[Date])",
              "    ),",
              "    FluxoCaixaCompleto[Categoria] = \"CDI\"",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "4307093e-a117-4bb7-a8e5-e4232cb2237e"
          },
          {
            "name": "ValorCDI_ComFolga",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "MAX('InvestimentoCDI'[ValorCDI]) * 1.5"
            ],
            "lineageTag": "e50c1849-e158-4edf-86d8-3ce361c50763"
          },
          {
            "name": "CorDivida",
            "expression": [
              "",
              "VAR Divida = [DividaAtual]",
              "RETURN",
              "SWITCH (",
              "    TRUE(),",
              "    Divida <= 1500, \"#2ECC71\",   -- Verde",
              "    Divida <= 2500, \"#F1C40F\",   -- Amarelo",
              "    Divida <= 3000, \"#E67E22\",   -- Laranja (alerta final)",
              "    \"#C00000\"                    -- Vermelho (erro)",
              ")",
              ""
            ],
            "lineageTag": "f0f2e22f-660a-4da3-99d6-9658f98a1af8"
          },
          {
            "name": "Valor Gasto",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "SUM (FluxoCaixaCompleto[Valor])"
            ],
            "lineageTag": "9613ac5b-e379-4c12-be5c-f7ccf4815ad6"
          },
          {
            "name": "Limite Categoria",
            "expression": [
              "",
              "MAX (LimitesCategorias[Limite])"
            ],
            "formatString": "0",
            "lineageTag": "f8d39bc2-2238-446b-8292-a00345290202"
          },
          {
            "name": "Cor Categoria",
            "expression": [
              "",
              "IF (",
              "    [Valor Gasto] > [Limite Categoria],",
              "    \"#C00000\",   -- vermelho",
              "    \"#4472C4\"    -- azul, (antes eu usava verde, mas misturado com os vermelhos na barra deu ruim)",
              ")"
            ],
            "lineageTag": "6220558c-ab01-4c89-97a0-d968b16656b1"
          },
          {
            "name": "Preco Medio Compra",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "VAR TotalInvestido =",
              "    CALCULATE (",
              "        SUM ( 'Investimentos'[Valor] ),",
              "        'Investimentos'[Operacao] = \"Aporte\"",
              "    )",
              "",
              "VAR QtdComprada =",
              "    CALCULATE (",
              "        SUM ( 'Investimentos'[QuantidadeCripto] ),",
              "        'Investimentos'[Operacao] = \"Aporte\"",
              "    )",
              "",
              "RETURN",
              "    DIVIDE ( TotalInvestido, QtdComprada )"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "2efe12f7-7e69-45ae-855c-fb7ac63a9c64"
          },
          {
            "name": "Preco Medio Venda",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "VAR TotalResgatado =",
              "    CALCULATE (",
              "        SUM ( 'Investimentos'[Valor] ),",
              "        'Investimentos'[Operacao] = \"Saque\"",
              "    )",
              "",
              "VAR QtdVendida =",
              "    CALCULATE (",
              "        SUM ( 'Investimentos'[QuantidadeCripto] ),",
              "        'Investimentos'[Operacao] = \"Saque\"",
              "    )",
              "",
              "RETURN",
              "    DIVIDE ( TotalResgatado, QtdVendida )"
            ],
            "formatString": "\"R$\"\\ #,0.###############;-\"R$\"\\ #,0.###############;\"R$\"\\ #,0.###############",
            "lineageTag": "6d0c142a-4651-443f-81f1-e4cbbb128b3c"
          },
          {
            "name": "PatrimônioTotal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": "[SaldoCDI] + [PatrimonioBTCAtual] + [PatrimonioCriptosAtual]",
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "18e877e9-31ec-4c29-88b0-2c143cc8c2ef"
          },
          {
            "name": "Total$Wishlist",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": "SUM(Wishlist[Preço]) + SUM(WishlistCssBuy[preco_brl])",
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "d319b82d-83bc-4b1c-acb0-f149a91b70fa"
          },
          {
            "name": "TotalPorCategoria",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "SUMX(",
              "    SUMMARIZE(",
              "        FluxoCaixaCompleto,",
              "        FluxoCaixaCompleto[Categoria],",
              "        \"TotalCategoria\", SUM(FluxoCaixaCompleto[Valor])",
              "    ),",
              "    [TotalCategoria]",
              ")",
              ""
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "f4e5b85f-2f61-46aa-96fc-4d758713080f"
          },
          {
            "name": "PatrimonioBTC_TimeSeries",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "SUM(InvestimentoBTC[ValorReais])"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "34a6fee1-b193-45ae-bf25-3712a04f0bd2"
          },
          {
            "name": "PatrimonioReal",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": "_Measures[PatrimônioTotal] - _Measures[DividaAtual]",
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "f2c9ed7b-367d-4e95-a8cf-ca2ad48af14e"
          },
          {
            "name": "PatrimonioCriptosAtual",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(InvestimentoCripto[ValorReais]),",
              "    InvestimentoCripto[DataHora] = MAX(InvestimentoCripto[DataHora])",
              ")"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "710eac4d-77e3-4006-af9b-ca385a6d9c7e"
          },
          {
            "name": "PatrimonioCDI_TimeSeries",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "SUM(InvestimentoCDI[ValorCDI])"
            ],
            "formatString": "\"R$\"\\ #,0.00;-\"R$\"\\ #,0.00;\"R$\"\\ #,0.00",
            "lineageTag": "8319f2ee-3268-4165-a90e-78f8a67e2ba9"
          },
          {
            "name": "CorSaldoMes",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    [SaldoMes] < 0, \"#C00000\",          -- prejuízo",
              "    [SaldoMes] < 500, \"#E6B300\",        -- quase nada",
              "    [SaldoMes] < 1000, \"#70AD47\",       -- ok",
              "    \"#4472C4\"                             -- forte",
              ")"
            ],
            "lineageTag": "6d716c5f-ea1e-4d96-a141-2af2611a8886"
          },
          {
            "name": "CotacaoCripto",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "VAR UltimaData =",
              "    CALCULATE(",
              "        MAX(InvestimentoCripto[DataHora])",
              "    )",
              "",
              "RETURN",
              "    CALCULATE(",
              "        MAX(InvestimentoCripto[PrecoCripto]),",
              "        InvestimentoCripto[DataHora] = UltimaData",
              "    )"
            ],
            "formatString": "\"R$\"\\ #,0.###############;-\"R$\"\\ #,0.###############;\"R$\"\\ #,0.###############",
            "lineageTag": "ce2d396e-8b20-4dda-b852-0ed2270ad1c1"
          },
          {
            "name": "Patrimonio Cripto",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"pt-BR\"}"
              }
            ],
            "expression": [
              "",
              "SUM(InvestimentoCripto[ValorReais])"
            ],
            "formatString": "\"R$\"\\ #,0.###############;-\"R$\"\\ #,0.###############;\"R$\"\\ #,0.###############",
            "lineageTag": "3b09c53d-bf93-464f-af23-93330d716db9"
          },
          {
            "name": "Último Insight IA",
            "expression": [
              "",
              "VAR _MaxData = MAX('Insights IA'[data_geracao])",
              "RETURN",
              "CALCULATE(",
              "    SELECTEDVALUE('Insights IA'[insight_texto]),",
              "    'Insights IA'[data_geracao] = _MaxData",
              ")"
            ],
            "lineageTag": "78bacf3d-7838-4f57-a260-779d5ae0b1bd"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i44FAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Column1\", type text}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Column1\"})",
                "in",
                "    #\"Removed Columns\""
              ],
              "type": "m"
            }
          }
        ]
      },
