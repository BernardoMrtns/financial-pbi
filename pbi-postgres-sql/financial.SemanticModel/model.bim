        "lineageTag": "ab88419d-a632-47d8-a3f9-f7db89df6fbc",
        "partitions": [
          {
            "name": "WishlistCssBuy",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"bernardofinancas.duckdns.org\", \"financial_db\"),",
                "    Table = Source{[Schema = \"public\", Item = \"wishlist_cssbuy\"]}[Data],",
                "    Cleaned = Table.RemoveColumns(Table, {\"id\"}),",
                "    Renamed = Table.RenameColumns(Cleaned, {",
                "        {\"item\", \"Item\"},",
                "        {\"categoria\", \"Categoria\"},",
                "        {\"links\", \"Links\"}",
                "    }),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(Renamed, {",
                "        {\"Item\", type text},",
                "        {\"Categoria\", type text},",
                "        {\"peso_aproximado\", type number},",
                "        {\"Links\", type text},",
                "        {\"preco_yuan\", Currency.Type}",
                "    }),",
                "    #\"Personalização Adicionada\" = Table.AddColumn(",
                "        #\"Tipo Alterado\",",
                "        \"preco_brl\",",
                "        each [preco_yuan] / 1.28,",
                "        Currency.Type",
                "    )",
                "in",
                "    #\"Personalização Adicionada\""
              ],
              "type": "m"
            }
          }
        ]
      },
