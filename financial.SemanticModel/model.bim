            "source": {
              "expression": [
                "let",
                "    Fonte = GoogleSheets.Contents(\"https://docs.google.com/spreadsheets/d/1JGj93l-FB4TCVMyGFQaNu7_k3_Jz4uFy_7DWUA5dQBY/edit?usp=sharing\"),",
                "    Wishlist_Table = Fonte{[name=\"Wishlist\",ItemKind=\"Table\"]}[Data],",
                "    #\"Cabeçalhos Promovidos\" = Table.PromoteHeaders(Wishlist_Table, [PromoteAllScalars=true]),",
                "    #\"Tipo Alterado\" = Table.TransformColumnTypes(#\"Cabeçalhos Promovidos\",{{\"Nome\", type text}, {\"Preço\", Currency.Type}, {\"Categoria\", type text}, {\"Prioridade\", type text}, {\"Link\", type text}}),",
                "    #\"Coluna Condicional Adicionada\" = Table.AddColumn(#\"Tipo Alterado\", \"Ordem_Prioridade\", each if [Prioridade] = \"Low\" then 1 else if [Prioridade] = \"Mid\" then 2 else if [Prioridade] = \"High\" then 3 else null)",
                "in",
                "    #\"Coluna Condicional Adicionada\""
              ],
              "type": "m"
            }
          }
        ]
      },
