table _Measures
	lineageTag: 72a6ae09-2f08-4e85-8d48-6f895404bb9a

	measure SaldoCDI =
			
			VAR UltimaData =
			    MAX(InvestimentoCDI[Data])
			RETURN
			CALCULATE(
			    SUM(InvestimentoCDI[ValorCDI]),
			    InvestimentoCDI[Data] = UltimaData
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: eb23c053-d525-4714-b2f6-9bb652a074fa

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure DividaAtual =
			
			CALCULATE(
			    SUM(FluxoCaixaCompleto[Valor]),
			    FluxoCaixaCompleto[Status] = "Pendente"
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 30831ecf-fa25-46c7-b1b4-e22233638dc8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure TotalParcelasMes =
			
			CALCULATE(
			    SUM(FluxoCaixaCompleto[Valor]),
			    FluxoCaixaCompleto[Tipo] = "Saída",
			    FluxoCaixaCompleto[Metodo] IN {
			        "Cartão de Crédito",
			        "Pix Parcelado",
			        "Assinatura Recorrente"
			    }
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 9c03f31c-6e45-4a24-963a-842cbf94a13a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure PatrimonioBTCAtual =
			
			CALCULATE(
			    SUM(InvestimentoBTC[ValorReais]),
			    InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: bd4ca602-57d4-43c3-9bac-f16aebf721fb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'SaldoBTC (Qtd)' =
			
			CALCULATE(
			    MAX(InvestimentoBTC[SaldoBTC]),
			    InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])
			)
		formatString: 0.00000000
		lineageTag: fe6d4909-c90b-447e-9958-c6d83564e513

	measure ValorCarteiraBTC = ```
			
			CALCULATE(
			    SUM(InvestimentoBTC[ValorReais]),
			    InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])
			)
			
			```
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 0becae7d-77be-4ac3-921c-7d455a4af914

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure CotaçãoBTC =
			
			CALCULATE(
			    MAX(InvestimentoBTC[PrecoBTC]),
			    FILTER(
			        ALL(InvestimentoBTC),
			        InvestimentoBTC[DataHora] = MAX(InvestimentoBTC[DataHora])
			    )
			)
		lineageTag: 8b545cc5-7f6b-48c9-9f8f-5e35710a0f08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Satoshis = [SaldoBTC (Qtd)] * 100000000
		formatString: 0
		lineageTag: 6ca937fd-cae2-4a96-acc1-8b4e4d550738

	measure TotalReceitas = SUM(Receitas[Valor])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 00449243-7e45-4381-9bb3-aa121aa25823

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure TotalDespesas =
			
			CALCULATE(
			    SUM(FluxoCaixaCompleto[Valor]),
			    FILTER(
			        FluxoCaixaCompleto,
			        FluxoCaixaCompleto[Tipo] = "Saída"
			            && FluxoCaixaCompleto[Categoria] <> "Investimento"
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: c58b48de-0a9a-46ac-827d-0d5325cb7a05

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure SaldodoMês = [TotalReceitas] - [TotalDespesas]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4fe9f9f1-eb51-471d-86e2-26aef14db600

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure SaldoCDI(Histórico) =
			
			VAR DataAtual = MAX(dCalendario[Date])
			RETURN
			CALCULATE(
			    SUM(InvestimentoCDI[ValorCDI]),
			    FILTER(
			        ALL(dCalendario), -- Remove filtros de data (olha o calendário todo)
			        dCalendario[Date] <= DataAtual -- Pega tudo que aconteceu ANTES ou ATÉ hoje
			    )
			)
		lineageTag: 35d51c0a-a118-4baa-90fe-6929cb037ed3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CorDoSaldo = ```
			
			SWITCH(
			    TRUE(),
			    [SaldodoMês] >= 500, "#4472C4",    -- azul, (antes eu usava verde, mas misturado com os vermelhos na barra deu ruim)
			    [SaldodoMês] > 0,    "#E6B300",    -- amarelo (sobrou pouco)
			    "#C00000"                            -- vermelho (zerado ou negativo)
			)
			
			```
		lineageTag: fd5718f2-27ca-4952-bb1e-ffbc9d5dbd28

	measure TotalAportado(Mês) =
			
			CALCULATE(
			    [TotalDespesas],
			    FluxoCaixaCompleto[Categoria] = "Investimento"
			)
		lineageTag: 5d1eee72-ecf8-4330-af33-2dfa0bde6f72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LimiteTotal = SUM(Limites[LimiteTotal])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		lineageTag: 007cc70a-f66f-4030-8074-ba3c8ca0815b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure LimiteUsado = ```
			
			CALCULATE(
			    SUM(FluxoCaixaCompleto[Valor]),
			    FluxoCaixaCompleto[Metodo] = "Cartão de Crédito",
			    dCalendario[Date] >= TODAY() 
			)
			```
		lineageTag: 27789dac-3d4c-4351-95d5-a37f4470d339

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LimiteDisponível = [LimiteTotal] - [LimiteUsado]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: edaea839-dff3-480b-aa4e-fb5d84747297

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Limite Tomado' = DIVIDE([LimiteUsado], [LimiteTotal], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8fd778a8-62c5-4863-ac20-617346ce37a7

	measure '% Limite Disponível' = ```
			
			DIVIDE(
			    [LimiteDisponível], 
			    [LimiteTotal], 
			    0
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 21112d8b-0295-4321-a5ca-849beb92d7b0

	measure 'Saldo CDI Acumulado' = ```
			
			CALCULATE(
			    SUM(FluxoCaixaCompleto[Valor]), 
			    FILTER(
			        ALL(dCalendario),
			        dCalendario[Date] <= MAX(dCalendario[Date])
			    ),
			    FluxoCaixaCompleto[Categoria] = "CDI"
			)
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4307093e-a117-4bb7-a8e5-e4232cb2237e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure ValorCDI_ComFolga =
			
			MAX('InvestimentoCDI'[ValorCDI]) * 1.5
		lineageTag: e50c1849-e158-4edf-86d8-3ce361c50763

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CorDivida = ```
			
			VAR Divida = [DividaAtual]
			RETURN
			SWITCH (
			    TRUE(),
			    Divida <= 1500, "#2ECC71",   -- Verde
			    Divida <= 2500, "#F1C40F",   -- Amarelo
			    Divida <= 3000, "#E67E22",   -- Laranja (alerta final)
			    "#C00000"                    -- Vermelho (erro)
			)
			
			```
		lineageTag: f0f2e22f-660a-4da3-99d6-9658f98a1af8

	measure 'Valor Gasto' =
			
			SUM (FluxoCaixaCompleto[Valor])
		lineageTag: 9613ac5b-e379-4c12-be5c-f7ccf4815ad6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Limite Categoria' =
			
			MAX (LimitesCategorias[Limite])
		formatString: 0
		lineageTag: f8d39bc2-2238-446b-8292-a00345290202

	measure 'Cor Categoria' =
			
			IF (
			    [Valor Gasto] > [Limite Categoria],
			    "#C00000",   -- vermelho
			    "#4472C4"    -- azul, (antes eu usava verde, mas misturado com os vermelhos na barra deu ruim)
			)
		lineageTag: 6220558c-ab01-4c89-97a0-d968b16656b1

	measure 'Preco Medio Compra' =
			
			VAR TotalInvestido =
			    CALCULATE (
			        SUM ( 'Investimentos'[Valor] ),
			        'Investimentos'[Operacao] = "Aporte",
			        'Investimentos'[Tipo] = "BTC"
			    )
			VAR QtdComprada =
			    CALCULATE (
			        SUM ( 'Investimentos'[QuantidadeBTC] ),
			        'Investimentos'[Operacao] = "Aporte",
			        'Investimentos'[Tipo] = "BTC"
			    )
			RETURN
			    IF (
			        QtdComprada > 0,
			        DIVIDE ( TotalInvestido, QtdComprada ),
			        BLANK ()
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 2efe12f7-7e69-45ae-855c-fb7ac63a9c64

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Preco Medio Venda' = ```
			
			VAR TotalResgatado = 
			    CALCULATE(
			        SUM('Investimentos'[Valor]), 
			        'Investimentos'[Operacao] = "Saque",
			        'Investimentos'[Tipo] = "BTC"
			    )
			VAR QtdVendida = 
			    CALCULATE(
			        SUM('Investimentos'[QuantidadeBTC]), 
			        'Investimentos'[Operacao] = "Saque",
			        'Investimentos'[Tipo] = "BTC"
			    )
			RETURN 
			    DIVIDE(TotalResgatado, QtdVendida)
			```
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 6d0c142a-4651-443f-81f1-e4cbbb128b3c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure PatrimônioTotal = [SaldoCDI] + [PatrimonioBTCAtual] + [PatrimonioCriptosAtual]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 18e877e9-31ec-4c29-88b0-2c143cc8c2ef

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Total$Wishlist = SUM(Wishlist[Preço]) + SUM(WishlistCssBuy[Preço BRL])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d319b82d-83bc-4b1c-acb0-f149a91b70fa

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure TotalPorCategoria = ```
			
			SUMX(
			    SUMMARIZE(
			        FluxoCaixaCompleto,
			        FluxoCaixaCompleto[Categoria],
			        "TotalCategoria", SUM(FluxoCaixaCompleto[Valor])
			    ),
			    [TotalCategoria]
			)
			
			```
		lineageTag: f4e5b85f-2f61-46aa-96fc-4d758713080f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PatrimonioBTC_TimeSeries =
			
