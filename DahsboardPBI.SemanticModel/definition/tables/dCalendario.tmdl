	partition dCalendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDARAUTO(),
				    "DateTime", [Date] + TIME(0,0,0),
				    "Ano", YEAR([Date]),
				    "Mês", FORMAT([Date], "mmmm"),
				    "Mês Abrev", FORMAT([Date], "mmm"),
				    "Mês Num", MONTH([Date]),
				    "AnoMês", FORMAT([Date], "yyyy-MM"),
				    "Trimestre", "T" & QUARTER([Date])
				)

	annotation PBI_Id = dda0cc2bf0b7430891a7b11233b816ca

